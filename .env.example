# ============================================================================
# RaktSetu – Environment Variables
# ============================================================================

# 1. Aiven Cloud MySQL Configuration (Get these from your Aiven Console)
DB_HOST=mysql-your-project.aivencloud.com
DB_PORT=23456
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_SSL=true

# 2. JWT Secret Key for Session Authentication
JWT_SECRET=raktsetu_super_secret_jwt_key_2026

# 3. Frontend API URL
# Leave empty for standalone demo with mock fallback
# Set to your backend URL when running live server
VITE_API_URL=http://localhost:5000
